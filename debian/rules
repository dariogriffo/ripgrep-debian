#!/usr/bin/make -f
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
RIPGREP_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/[-~].*//')

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	@arch="$(DEB_HOST_ARCH)"; \
	case "$$arch" in \
		amd64) TARGET="x86_64-unknown-linux-musl" ;; \
		arm64) TARGET="aarch64-unknown-linux-musl" ;; \
		armhf) TARGET="armv7-unknown-linux-musleabihf" ;; \
		*) echo "Unsupported architecture: $$arch"; exit 1 ;; \
	esac; \
	REL="ripgrep-$(RIPGREP_VERSION)-$$TARGET"; \
	echo "Downloading $$REL..."; \
	wget -q "https://github.com/BurntSushi/ripgrep/releases/download/$(RIPGREP_VERSION)/$$REL.tar.gz"; \
	rm -rf ripgrep-dist; \
	mkdir -p ripgrep-dist; \
	tar -xf "$$REL.tar.gz" -C ripgrep-dist --strip-components=1; \
	rm -f "$$REL.tar.gz"

override_dh_auto_install:
	install -D -m 755 ripgrep-dist/rg debian/ripgrep/usr/bin/rg
	install -D -m 644 ripgrep-dist/doc/rg.1 debian/ripgrep/usr/share/man/man1/rg.1
	install -D -m 644 ripgrep-dist/complete/rg.bash debian/ripgrep/usr/share/bash-completion/completions/rg
	install -D -m 644 ripgrep-dist/complete/rg.fish debian/ripgrep/usr/share/fish/vendor_completions.d/rg.fish
	install -D -m 644 ripgrep-dist/complete/_rg debian/ripgrep/usr/share/zsh/vendor-completions/_rg

override_dh_installchangelogs:
	dh_installchangelogs ripgrep-dist/doc/CHANGELOG.md

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf ripgrep-dist || true

override_dh_strip:

override_dh_shlibdeps:
